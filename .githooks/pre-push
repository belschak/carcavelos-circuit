#!/bin/sh
# Refuse direct pushes to main. Work on a branch and open a PR (see AGENTS.md).
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push to main blocked. Push a branch and open a pull request instead." >&2
    exit 1
  fi
done
exit 0
