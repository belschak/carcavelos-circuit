/* "Postcard from Carcavelos": the menu redesign (Role 4). Loaded LAST in RaceHud.uxml, so for the same selector these
   rules win over RaceHud.uss, StartScreen.uss and Leaderboard.uss. The idea: a summer postcard of the seaside track.
   A real logo (sun, surf wave, the word Carcavelos, the CIRCUIT ribbon), the round cartoon face Lilita One for every
   big word (UI/HudArt.uss .f-display), sunset ribbons as menu titles, sun-yellow main buttons, cream paper pills and
   ink-outlined navy cards. Only menus and overlays change here; the driving HUD keeps its R15 plates.
   Plates: tools/ui_art/make_postcard_plates.py (PNG, 9-sliced like the R15 plates). Logo: tools/ui_art/logo.svg. */

/* ---------- Logo: five pictures in one box (positions = their place in the 1120 x 628 vector logo) ---------- */
.lg {
    position: relative;
    width: 540px;
    height: 303px;
    margin-left: -8px;
}

.lg-layer {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.lg-sun { left: 31.786%; top: 9.554%; width: 36.429%; height: 64.968%; background-image: url("Art/Logo/logo-sun.png"); }
.lg-wave { left: 2.232%; top: 59.395%; width: 95.714%; height: 15.924%; background-image: url("Art/Logo/logo-wave.png"); }
.lg-word { left: 3.661%; top: 30.096%; width: 93.929%; height: 35.032%; background-image: url("Art/Logo/logo-word.png"); }
.lg-badge { left: 32.5%; top: 3.025%; width: 35%; height: 18.471%; background-image: url("Art/Logo/logo-badge.png"); }
.lg-ribbon { left: 19.196%; top: 73.726%; width: 61.786%; height: 19.745%; background-image: url("Art/Logo/logo-ribbon.png"); }

/* Pop-in, one part after the other: the sun rises, the wave rolls in from the left, the word lands like a stamp,
   the badge drops, the ribbon flips up. ease-out-back = a small overshoot, like a sticker slapped on. */
.lg-sun {
    opacity: 0;
    scale: 0.2 0.2;
    transition-property: opacity, scale;
    transition-duration: 200ms, 520ms;
    transition-timing-function: ease-out, ease-out-back;
    transition-delay: 60ms;
}

.lg-wave {
    opacity: 0;
    translate: -120px 0;
    transition-property: opacity, translate;
    transition-duration: 220ms, 520ms;
    transition-timing-function: ease-out, ease-out-back;
    transition-delay: 220ms;
}

.lg-word {
    opacity: 0;
    scale: 1.7 1.7;
    transition-property: opacity, scale;
    transition-duration: 140ms, 380ms;
    transition-timing-function: ease-out, ease-out-back;
    transition-delay: 380ms;
}

.lg-badge {
    opacity: 0;
    translate: 0 -70px;
    rotate: -12deg;
    transition-property: opacity, translate, rotate;
    transition-duration: 160ms, 420ms, 420ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
    transition-delay: 640ms;
}

.lg-ribbon {
    opacity: 0;
    translate: 0 40px;
    scale: 0.6 0.6;
    transition-property: opacity, translate, scale;
    transition-duration: 160ms, 420ms, 420ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
    transition-delay: 760ms;
}

.intro-in .lg-sun,
.intro-in .lg-wave,
.intro-in .lg-word,
.intro-in .lg-badge,
.intro-in .lg-ribbon {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    rotate: 0deg;
}

/* The light sweep (UI/TitleScreen.cs moves the bands): a gold-tinted copy of the word inside each band. */
.lg-glint {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 56px;
    overflow: hidden;
    opacity: 0;
}

.lg-glint--soft {
    width: 170px;
}

.lg-glint--on {
    opacity: 1;
}

.lg-glint-copy {
    position: absolute;
    left: 0;
    top: 0;
    width: 540px;
    height: 303px;
}

/* Three classes: beats ".intro-in .lg-word", the copy never pops in, it is always in place. */
.lg .lg-glint-copy .lg-word {
    opacity: 1;
    scale: 1 1;
    transition-duration: 0s;
    -unity-background-image-tint-color: rgb(255, 214, 110);
}

.lg .lg-glint--soft .lg-glint-copy .lg-word {
    -unity-background-image-tint-color: rgba(255, 200, 90, 0.55);
}

/* The team's round (ROUND 3) as a cream stamp on the ribbon's right end. */
.start-screen .lg-stamp {
    position: absolute;
    right: 9%;
    bottom: 2%;
    margin-left: 0;
    padding: 2px 12px 9px 12px;
    font-size: 17px;
    rotate: 8deg;
}

/* ---------- Start screen layout: the logo takes the place of the old lockup, so everything below moves up ---------- */
.start-screen .ts-layout {
    padding-top: 18px;
}

.start-screen .ts-hero {
    align-items: center;
    max-width: 640px;
}

/* PRESS ANY KEY: a sun-yellow arcade button with ink letters (like the click-to-play button on the web page). */
.start-screen .ts-prompt {
    margin-top: 22px;
    margin-left: 0;
    height: 64px;
    padding: 0 44px 8px 44px;
    font-size: 30px;
    letter-spacing: 2px;
    color: var(--ink);
    -unity-text-outline-width: 0;
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.45);
}

.start-screen .ts-best {
    margin-top: 12px;
    margin-left: 0;
}

.start-screen .ts-menu {
    margin-top: 12px;
    justify-content: center;
}

/* The settings / credits / sound / noon-sunset pills on the start screen: cream paper, ink words. */
.start-screen .ts-menu .menu-pill {
    background-image: url("Art/plate-paper.png");
    height: 46px;
    padding: 0 16px 6px 8px;
}

.start-screen .ts-menu .menu-pill-text {
    color: var(--ink);
}

.start-screen .ts-menu .menu-pill--muted .menu-pill-text {
    color: var(--cc-coral);
}

/* ---------- Plates of every menu ---------- */
/* Main action = sun yellow (PRESS ANY KEY, RETRY, CLOSE, START RACE, the picked race mode). */
.plate--orange {
    background-image: url("Art/plate-sun.png");
}

/* The coach's hint while driving keeps its orange (cream words on it). */
.hint-chip.plate--orange {
    background-image: url("Art/plate-orange.png");
}

/* Cards and buttons of the menus: ink-outlined navy (the driving HUD keeps its own plates). */
.menu-card.plate,
.card.plate,
.lb.plate,
.menu-pill.plate {
    background-image: url("Art/plate-ink.png");
}

.menu-pill.plate.plate--orange {
    background-image: url("Art/plate-sun.png");
}

.start-screen .ts-menu .menu-pill.plate {
    background-image: url("Art/plate-paper.png");
}

/* Menu titles (SETTINGS, CREDITS, NOON ROOM ...) sit on a sunset ribbon. */
.menu-title {
    background-image: url("Art/plate-sunset.png");
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 36;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5px;
    padding: 2px 30px 12px 30px;
    font-size: 34px;
    letter-spacing: 1px;
    color: var(--cc-white);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 3px 0 rgba(14, 34, 56, 0.8);
    rotate: -1.5deg;
}

.menu-card {
    padding-top: 26px;
}

/* The calcada wave line under a menu title: the ribbon replaces it. */
.menu-card .wave-host {
    display: none;
}

/* The page behind a menu: a deep sunset ink instead of flat blue, so the card pops. */
.menu-bg {
    background-color: rgba(26, 20, 64, 0.66);
}

/* ---------- Results card ---------- */
.res-headline {
    font-size: 76px;
    -unity-text-outline-width: 5px;
    text-shadow: 0 7px 0 rgba(14, 34, 56, 0.9);
    rotate: -3deg;
}

.retry-button {
    color: var(--ink);
    -unity-text-outline-width: 0;
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.45);
}

/* ---------- Pause ---------- */
.pause-title {
    font-size: 110px;
    letter-spacing: 4px;
    -unity-text-outline-width: 7px;
    text-shadow: 0 9px 0 rgba(14, 34, 56, 0.9);
    rotate: -3deg;
}

/* ---------- Leaderboard header: the same sunset ribbon ---------- */
.lb-head {
    background-image: url("Art/plate-sunset.png");
}

.lb-title {
    font-size: 24px;
    letter-spacing: 1px;
}

/* ---------- "On the track" postcard (UI/TitleScreen.cs): the map's sights, one at a time, bottom right ---------- */
.pc {
    position: absolute;
    right: 56px;
    bottom: 10px;
    width: 400px;
    height: 66px;
    flex-direction: row;
    align-items: center;
    padding: 2px 16px 8px 10px; /* bottom: the plate's lip */
    background-image: url("Art/plate-paper.png");
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 36;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5px;
    rotate: -1.5deg;
    opacity: 0;
    translate: 0 30px;
    transition-property: opacity, translate;
    transition-duration: 220ms, 380ms;
    transition-timing-function: ease-out, ease-out-back;
    transition-delay: 1500ms;
}

.intro-in .pc {
    opacity: 1;
    translate: 0 0;
}

.intro-in .pc--out {
    opacity: 0;
    translate: 0 8px;
    transition-delay: 0s;
    transition-duration: 200ms, 200ms;
}

.pc-stamp {
    width: 40px;
    height: 44px;
    margin-right: 12px;
    background-image: url("Art/plate-sunset.png");
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 36;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5px;
    rotate: 6deg;
}

.pc--alt .pc-stamp {
    background-image: url("Art/plate-azul.png");
    rotate: -6deg;
}

.pc-words {
    flex-grow: 1;
    flex-shrink: 1;
}

.pc-kicker {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--cc-coral);
}

.pc-title {
    font-size: 21px;
    color: var(--ink);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    margin-top: -2px;
}

.pc-text {
    font-size: 15px;
    letter-spacing: 0.5px;
    color: rgba(14, 34, 56, 0.78);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hud--narrow .pc {
    right: 24px;
    width: 300px;
}

.reduce-motion .pc {
    transition-duration: 0s;
    transition-delay: 0s;
}

/* Room cards in the online lobby: the room that ENTER joins is azulejo blue. */
.menu-pill.plate.plate--blue {
    background-image: url("Art/plate-azul.png");
}

/* Keys on the cream start-screen pills: ink keys with cream letters, so they do not vanish on the paper. */
.start-screen .ts-menu .keycap {
    background-color: var(--ink);
    border-bottom-color: #061325;
}

.start-screen .ts-menu .keycap > Label {
    color: var(--cc-white);
}

/* Credits page 1: the logo word on top, the team in the middle of the page. */
#credits-page-1 {
    justify-content: center;
}

.credits-logo {
    width: 330px;
    height: 69px;
    margin-bottom: 14px;
    background-image: url("Art/Logo/logo-word.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- Narrow windows (4:3) and reduced motion ---------- */
.hud--narrow .lg {
    width: 460px;
    height: 258px;
}

.hud--narrow .lg-glint-copy {
    width: 460px;
    height: 258px;
}

.reduce-motion .lg-layer,
.reduce-motion .intro-in .lg-layer {
    transition-duration: 0s;
    transition-delay: 0s;
}

.reduce-motion .lg-glint {
    display: none;
}
