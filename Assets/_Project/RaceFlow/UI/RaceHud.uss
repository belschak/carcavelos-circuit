/* HUD styles, design direction "Azulejo Arcade" (task R15, restyle of "Linha de Costa"): coloured plates with a cream
   stroke and a hard navy shadow, one chunky display face with thick outlines, few big words, overshoot motion.
   Blue and orange stay the drift/boost signals, mint = ahead, coral = behind (docs/art-style.md, UI/HudArt.uss).
   Like CSS, with "-unity-" names for Unity-only properties. Sizes are for a 1280x720 reference screen
   (PanelSettings scales them, matching the screen HEIGHT, so the HUD is always the same share of the screen).

   Animation pattern (read this first):
   - Nothing that animates is ever display:none (UI Toolkit cannot animate from display:none). Hidden = opacity 0,
     and RaceHud.cs switches clicks off on hidden parts.
   - RaceHud.cs puts ONE state class on .hud-root: st-ready, st-countdown, st-racing or st-results.
     Rules below like ".st-ready .race-layer" then fade whole layers. In Results it also adds st-finish
     (finish moment, task P6b, at the end of this file): the short beat before the results card comes in.
   - Parts that come and go get "is-shown". A "...--pop" class has transition-duration 0s: C# adds it, removes it
     two frames later (HudFx.Punch), and the normal transition animates back = a punch. */

/* ---------- Tokens, fonts, plates: UI/HudArt.uss (loaded by the theme, so every HUD document has them) ---------- */

/* Reset Unity's default label spacing. One class = same weight as the theme's rule, and this sheet wins because it
   sits deeper in the hierarchy. It is near the top so later rules in this file (same weight) can still set margins. */
.unity-label {
    margin: 0;
    padding: 0;
    color: var(--cc-white);
}

/* ---------- Root, layers, state classes ---------- */
.hud-root {
    flex-grow: 1;
    align-items: center;
}


.race-layer {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 250ms;
    transition-timing-function: ease-out;
}

.st-ready .race-layer,
.st-results .race-layer {
    opacity: 0;
}

/* Safe frame: on very wide screens the corners stay inside the player's attention cone. */
.hud-safe {
    flex-grow: 1;
    width: 100%;
    max-width: 1600px;
    padding: 26px 34px 24px 34px;
    justify-content: space-between;
}

.hud-top, .hud-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.hud-bottom {
    align-items: flex-end;
}

.row {
    flex-direction: row;
    align-items: center;
}

/* ---------- Panels: navy plates (the picture comes from .plate in UI/HudArt.uss) ---------- */
.panel {
    padding: 8px 20px 16px 18px; /* bottom: 6 px more for the hard shadow inside the plate picture */
    transition-property: scale;
    transition-duration: 220ms;
    transition-timing-function: ease-out-back;
}

.panel--pop {
    scale: 1.1 1.1;
    transition-duration: 0s;
}

.caption {
    font-size: 18px;
    letter-spacing: 2px;
    color: rgba(255, 246, 227, 0.72);
}

.caption--small {
    font-size: 16px;
    letter-spacing: 1px;
}

/* ---------- A. Time panel: lap, time, best on one plate ---------- */
.time-panel {
    min-width: 268px;
    transform-origin: left top;
}

.lap-counter {
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--cc-sand);
}

.timer-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: -2px;
    transition-property: opacity;
    transition-duration: 200ms;
}

.st-countdown .timer-row {
    opacity: 0.45; /* the time is not running yet */
}

.timer-main {
    font-size: 64px;
    color: var(--cc-white);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 4px 0 rgba(14, 34, 56, 0.65);
    -unity-text-align: lower-left;
}

.timer-fraction {
    font-size: 36px;
    margin-bottom: 8px;
    color: rgba(255, 246, 227, 0.80);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 3px 0 rgba(14, 34, 56, 0.65);
    -unity-text-align: lower-left;
}

.best-row {
    flex-direction: row;
    align-items: center;
    margin-top: 0;
}

.best {
    margin-left: 8px;
    font-size: 22px;
    color: var(--cc-sand);
}

.best--none {
    color: rgba(255, 246, 227, 0.45);
}

/* ---------- A2. Medal target chip (under the time panel): a small plate ---------- */
.top-left {
    align-items: flex-start;
}

.medal-target {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin-top: 6px;
    padding: 0 16px 6px 14px; /* 6 px at the bottom: the plate's shadow */
    opacity: 0;
    transform-origin: left;
    transition-property: opacity, scale;
    transition-duration: 300ms, 220ms;
    transition-timing-function: ease-out, ease-out-back;
}

.medal-target.is-shown {
    opacity: 1;
}

/* The lap is already slower than the target: the chip stays (you still see what you missed) but steps back. */
.medal-target.is-shown.medal-target--missed {
    opacity: 0.45;
}

.medal-target--pop {
    scale: 1.25 1.25;
    transition-duration: 0s;
}

.medal-target-name {
    margin-left: 10px;
    font-size: 19px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.88);
}

.medal-target-time {
    margin-left: 10px;
    font-size: 22px;
    color: var(--cc-white);
}

/* Medal gem: a small diamond tile (same shape as the checkpoint pips), coloured by the medal class on a parent. */
.medal-gem {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    rotate: 45deg;
    border-width: 2px;
    border-color: var(--ink);
    background-color: rgba(255, 246, 227, 0.22);
}

.medal--bronze .medal-gem { background-color: var(--medal-bronze); }
.medal--silver .medal-gem { background-color: var(--medal-silver); }
.medal--gold .medal-gem { background-color: var(--medal-gold); }
.medal--deans .medal-gem { background-color: var(--medal-deans); border-color: var(--cc-white); }

.medal-target--missed .medal-gem {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 246, 227, 0.55); /* hollow gem = not reachable this lap */
}

/* ---------- A3. Ghost chip (audit 13), under the medal chip: the same small plate ---------- */
.ghost-chip {
    flex-direction: row;
    align-items: center;
    height: 38px;
    margin-top: 4px;
    padding: 0 14px 6px 13px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.ghost-chip.is-shown {
    opacity: 1;
}

/* A round dot in the ghost's own colour (GhostPlayer: Dean's ghost warm gold, your own ghost light blue). */
.ghost-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--cc-white);
    background-color: #8CCCFF;
}

.ghost-chip--deans .ghost-dot {
    background-color: #FFCC66;
}

.ghost-chip-name {
    margin-left: 9px;
    font-size: 17px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.85);
}

.ghost-chip-time {
    margin-left: 9px;
    font-size: 20px;
    color: var(--cc-white);
}

/* ---------- B. Checkpoint pips ---------- */
.cp-panel {
    align-items: flex-end;
    padding: 8px 16px 18px 18px;
}

.cp-count {
    margin-left: 10px;
    font-size: 24px;
    color: var(--cc-white);
}

.cp-pips {
    flex-direction: row;
    margin-top: 10px;
    margin-right: 4px;
}

.cp-pip {
    width: 16px;
    height: 16px;
    margin-left: 12px;
    border-radius: 4px;
    rotate: 45deg;
    background-color: rgba(255, 246, 227, 0.22);
    border-width: 2px;
    border-color: rgba(255, 246, 227, 0);
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 120ms, 120ms, 180ms, 700ms;
    transition-timing-function: linear, linear, ease-out-back, ease-in-out-sine;
}

.cp-pip--passed {
    background-color: var(--cc-white);
}

.cp-pip--next {
    background-color: rgba(255, 246, 227, 0.10);
    border-color: var(--cc-white);
}

.cp-pip--dim {
    opacity: 0.4; /* toggled every 0.7 s on the "next" pip = slow pulse */
}

.cp-pip--finish {
    border-color: var(--cc-sand);
}

.cp-pip--finish.cp-pip--passed,
.cp-pip--finish.cp-pip--next {
    background-color: var(--cc-sand);
}

.cp-pip--pop {
    scale: 1.7 1.7;
    transition-duration: 0s;
}

/* ---------- C. Split chip: mint = ahead of your best, coral = behind, navy = first lap ---------- */
.split {
    position: absolute;
    top: 26px;
    left: 0;
    right: 0;
    align-items: center;
}

.split-chip {
    flex-direction: row;
    align-items: center;
    padding: 4px 20px 12px 16px; /* bottom: the chip's shadow */
    background-image: url("Art/plate-mint.png");
    opacity: 0;
    translate: 0 -24px;
    transition-property: opacity, translate, scale;
    transition-duration: 160ms, 260ms, 220ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
}

.split.is-shown .split-chip {
    opacity: 1;
    translate: 0 0;
}

.split--behind .split-chip {
    background-image: url("Art/plate-coral.png");
}

.split--neutral .split-chip {
    background-image: url("Art/plate-navy-chip.png");
}

/* A big gain (half a second or more): the number turns gold. */
.split--big .split-value {
    color: var(--sun);
}

.split-chip--pop {
    scale: 1.25 1.25;
    transition-duration: 0s;
}

.split-words {
    margin-right: 12px;
    align-items: flex-start;
}

.split-cp {
    font-size: 16px;
    letter-spacing: 2px;
    color: rgba(255, 246, 227, 0.92);
}

.split-word {
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--cc-white);
}

.split-value {
    font-size: 42px;
    color: var(--cc-white);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 3px 0 rgba(14, 34, 56, 0.65);
}

/* ---------- D. Callouts: hint, wrong way, stuck ---------- */
.callout {
    position: absolute;
    top: 112px;
    left: 0;
    right: 0;
    align-items: center;
}

.callout-chip {
    flex-direction: row;
    align-items: center;
    opacity: 0;
    translate: 0 -20px;
    transition-property: opacity, translate, scale;
    transition-duration: 160ms, 260ms, 220ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
}

.callout.is-shown .callout-chip {
    opacity: 1;
    translate: 0 0;
}

/* Shake: 3 classes so it beats ".callout.is-shown .callout-chip" above. */
.callout.is-shown .callout-chip--shake-l { translate: -7px 0; transition-duration: 0s; }
.callout.is-shown .callout-chip--shake-r { translate: 7px 0; transition-duration: 0s; }

/* Warning = orange plate, ink text. */
.hint-chip {
    padding: 8px 22px 16px 10px;
}

.hint-icon {
    width: 34px;
    height: 34px;
    margin-right: 12px;
    border-radius: 17px;
    background-color: var(--ink);
    color: var(--cc-orange);
    font-size: 20px;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.hint-text {
    font-size: 23px;
    letter-spacing: 1px;
    color: var(--ink);
}

/* Coach tip: blue plate, cream text. Coach praise: sand plate. Only warnings shake; tips and praise bounce. */
.hint--tip .hint-chip { background-image: url("Art/plate-blue.png"); }
.hint--tip .hint-text { color: var(--cc-white); }
.hint--tip .hint-icon { color: var(--plate-blue-lo); background-color: var(--cc-white); }
.hint--praise .hint-chip { background-image: url("Art/plate-sand.png"); }
.hint--praise .hint-icon { color: var(--cc-sand); }

.callout.is-shown .callout-chip--pop { scale: 1.12 1.12; transition-duration: 0s; }

/* Wrong way: a coral chip, the one HUD part that tilts (an angle reads "danger"). */
.wrong-way-chip {
    flex-direction: column;
    padding: 10px 34px 18px 34px;
    rotate: -2deg;
}

.wrong-way-title {
    font-size: 44px;
    letter-spacing: 1px;
    color: var(--cc-white);
}

.wrong-way-sub {
    margin-top: 2px;
    font-size: 19px;
    letter-spacing: 3px;
    color: var(--cc-white);
}

.wrong-way-chip--pulse {
    scale: 1.06 1.06;
}

.stuck-chip {
    padding: 10px 22px 16px 18px;
}

.stuck-title {
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--cc-white);
}

/* ---------- E. Speed gauge ---------- */
.speed-gauge {
    width: 176px;
    height: 176px;
    border-radius: 88px;
    background-color: rgba(19, 49, 79, 0.72);
    border-width: 3px;
    border-color: rgba(255, 246, 227, 0.85);
    align-items: center;
    justify-content: center;
}

.speed-arc-host {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}

.speed-arc {
    flex-grow: 1;
}

.speed-centre {
    align-items: center;
    margin-top: 6px;
}

.speed {
    font-size: 62px;
    color: var(--cc-white);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 3px 0 rgba(14, 34, 56, 0.65);
    -unity-text-align: middle-center;
    transition-property: scale, color;
    transition-duration: 220ms, 120ms;
    transition-timing-function: ease-out-back, linear;
}

.speed--boost {
    color: var(--cc-orange);
}

.speed--pop {
    scale: 1.25 1.25;
    transition-duration: 0s;
}

/* ---------- F. Drift meter ---------- */
.drift-panel {
    min-width: 300px;
    padding: 8px 18px 18px 16px;
}

.drift-head {
    height: 30px;
    margin-bottom: 6px;
}

.drift-label {
    font-size: 20px;
    letter-spacing: 2px;
    color: rgba(255, 246, 227, 0.85);
    margin-right: 10px;
    transform-origin: left;
    transition-property: scale, color;
    transition-duration: 220ms, 100ms;
    transition-timing-function: ease-out-back, linear;
}

.drift-label--boost {
    color: var(--cc-orange);
    font-size: 28px;
    letter-spacing: 2px;
}

.drift-label--pop {
    scale: 1.5 1.5;
    transition-duration: 0s;
}

.drift-pip {
    width: 14px;
    height: 14px;
    margin-left: 10px;
    border-radius: 3px;
    rotate: 45deg;
    border-width: 2px;
    border-color: var(--ink);
    background-color: rgba(255, 246, 227, 0.22);
    transition-property: background-color, scale;
    transition-duration: 100ms, 220ms;
    transition-timing-function: linear, ease-out-back;
}

.drift--s1 .drift-pip--1,
.drift--s2 .drift-pip--1 { background-color: var(--drift-s1); }
.drift--s2 .drift-pip--2 { background-color: var(--drift-s2); }
.drift--boost .drift-pip { background-color: var(--cc-orange); }

.drift-pip--pop {
    scale: 1.8 1.8;
    transition-duration: 0s;
}

.drift-bar {
    width: 300px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(14, 34, 56, 0.55);
    border-width: 2px;
    border-color: rgba(255, 246, 227, 0.85);
    overflow: hidden;
    transform-origin: left;
    transition-property: scale;
    transition-duration: 220ms;
    transition-timing-function: ease-out-back;
}

.drift-bar--pop {
    scale: 1 1.35;
    transition-duration: 0s;
}

/* The fill is scaled from the left (no width change = no layout pass every frame). */
.drift-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    transform-origin: left;
    scale: 0 1;
    background-color: var(--cc-white);
    transition-property: background-color;
    transition-duration: 80ms;
}

.drift--s1 .drift-fill { background-color: var(--drift-s1); }
.drift--s2 .drift-fill { background-color: var(--drift-s2); }
.drift--boost .drift-fill { background-color: var(--cc-orange); }

/* Marks where stage 1 starts (left is set from RaceHud.stage1At). */
.drift-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    background-color: rgba(255, 246, 227, 0.55);
}

/* A light streak running through the bar while boosting. */
.drift-shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40px;
    background-color: rgba(255, 255, 255, 0.35);
    translate: -60px 0;
    opacity: 0;
}

.drift--boost .drift-shine {
    opacity: 1;
}

.drift-shine--run {
    translate: 340px 0;
    transition-property: translate;
    transition-duration: 500ms;
    transition-timing-function: linear;
}

/* ---------- G. Boost edge glow (gradient texture set in RaceHud.cs) ---------- */
.edge-glow {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 240px;
    opacity: 0;
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
}

.edge-glow--left { left: 0; }
.edge-glow--right { right: 0; }

.edge-glow.is-shown {
    opacity: 1;
    transition-duration: 120ms;
}

/* ---------- H. Footer key hint: a plate with keycaps, above the position plate ---------- */
.controls-hint {
    position: absolute;
    bottom: 124px; /* the position plate (PositionsHud) sits at the bottom centre */
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 18px 6px 12px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 400ms;
}

.controls-hint.is-shown {
    opacity: 1;
}

/* Narrow windows (RaceHud sets hud--narrow below 1230 reference px, e.g. 4:3 and 16:10). The hint chip drops
   below the medal and ghost pills so it never covers the lap time, and the key bar moves right, into the gap between the
   drift panel (ends at 366 px) and the speed gauge (starts 210 px from the right). */
/* The split chip drops below the top row: on narrow screens a wide checkpoint panel reaches the middle. */
.hud--narrow .split {
    top: 118px;
}

.hud--narrow .callout {
    top: 266px; /* below the ghost chip too (audit 13) */
}

.hud--narrow .controls-hint {
    translate: 0 0;
}

/* That gap has no room for a third key, so the P key (audit 9) is left out there. It is still listed on the start
   screen and on the PAUSED card. A static part of a hint, never animated, so display:none is fine here. */
.hud--narrow .controls-hint .key--pause {
    display: none;
}

/* Keycaps (also used on the start and results screens). */
.keycap {
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    margin: 0 3px;
    border-radius: 7px;
    background-color: var(--cc-white);
    border-bottom-width: 4px;
    border-bottom-color: #C9B48A;
    align-items: center;
    justify-content: center;
}

.keycap > Label {
    font-size: 18px;
    color: var(--ink);
    letter-spacing: 1px;
}

.keycap--wide {
    min-width: 70px;
}

.keycap--big {
    min-width: 38px;
    height: 38px;
    margin: 0 12px;
}

.keycap--big > Label {
    font-size: 22px;
}

.key-text {
    font-size: 19px;
    letter-spacing: 1px;
    color: var(--cc-white);
    margin: 0 18px 0 7px;
    -unity-text-align: middle-left;
}

.key-text--last {
    margin-right: 0;
}

/* ---------- Countdown ---------- */
.cd {
    position: absolute;
    top: 92px;
    left: 0;
    right: 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity, translate, scale;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.cd.is-shown {
    opacity: 1;
}

.cd-tile {
    width: 140px;
    height: 140px;
    border-radius: 26px;
    rotate: 45deg;
    align-items: center;
    justify-content: center;
    background-color: var(--cc-white);
    border-width: 8px;
    border-color: var(--plate-blue-hi);
    border-bottom-color: var(--plate-blue-lo);
    border-right-color: var(--plate-blue-lo);
    transition-property: scale, rotate, opacity, background-color, border-color;
    transition-duration: 280ms, 280ms, 110ms, 100ms, 100ms;
    transition-timing-function: ease-out-back, ease-out-back, ease-out, linear, linear;
}

.cd-tile--pop {
    scale: 2.2 2.2;
    rotate: 70deg;
    opacity: 0;
    transition-duration: 0s;
}

.cd-num {
    rotate: -45deg;
    font-size: 88px;
    color: var(--ink);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.cd--go .cd-tile {
    background-color: var(--cc-orange);
    border-color: var(--cc-white);
    transition-duration: 300ms, 300ms, 110ms, 100ms, 100ms;
    transition-timing-function: ease-out-back, ease-out-back, ease-out, linear, linear;
}

.cd--go .cd-num {
    font-size: 52px;
    color: var(--cc-white);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 4px 0 rgba(14, 34, 56, 0.7);
}

.cd--go .cd-tile--pop-go { /* 2 classes, so it beats ".cd--go .cd-tile" and really jumps (duration 0s) */
    scale: 2.6 2.6;
    opacity: 0;
    transition-duration: 0s;
}

/* GO flies up and fades. "Two classes" version too, because ".cd.is-shown" (2 classes) would otherwise keep opacity 1. */
.cd--exit,
.cd.is-shown.cd--exit {
    translate: 0 -48px;
    scale: 1.25 1.25;
    opacity: 0;
    transition-duration: 260ms;
    transition-timing-function: ease-in-cubic;
}

.cd-lamps {
    flex-direction: row;
    margin-top: 44px;
}

.cd-lamp {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin: 0 7px;
    border-width: 3px;
    border-color: var(--ink);
    background-color: rgba(255, 246, 227, 0.35);
    transition-property: background-color, scale;
    transition-duration: 90ms, 220ms;
    transition-timing-function: linear, ease-out-back;
}

.cd-lamp--lit {
    background-color: var(--cc-blue);
    scale: 1.2 1.2;
}

.cd--go .cd-lamp {
    background-color: var(--cc-orange);
    scale: 1.2 1.2;
}

.go-flash {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--cc-white);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.go-flash--pop {
    opacity: 0.18;
    transition-duration: 0s;
}

/* ---------- Full-screen overlays (start, results) ---------- */
.overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 250ms;
    transition-timing-function: ease-out;
}

.st-ready .start-screen,
.st-results .results-screen {
    opacity: 1;
}

.overlay-bg, .pattern-host {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.azulejo {
    flex-grow: 1;
    opacity: 0.07;
}

.results-screen .azulejo {
    opacity: 0.08;
}

.calcada {
    flex-grow: 1;
}

.wave-host {
    width: 360px;
    height: 16px;
    margin: 8px 0 6px 0;
    border-radius: 3px;
    overflow: hidden;
}

.wave-host--small {
    width: 300px;
    height: 12px;
    margin: 6px 0 14px 0;
}

/* ---------- Start screen ---------- */
.start-content {
    align-items: center;
}

.pill {
    margin-top: 44px;
    height: 66px;
    padding: 0 36px 6px 36px; /* bottom: the orange lip of the plate */
    font-size: 26px;
    letter-spacing: 1px;
    color: var(--cc-white);
    -unity-text-align: middle-center;
}

.pill--loading {
    background-image: url("Art/plate-navy.png");
    color: var(--cc-white);
}

.pill--pop {
    scale: 0.92 0.92;
    transition-duration: 0s;
}

.controls-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 30px;
    padding: 8px 18px 14px 18px;
    max-width: 1100px;
}

.start-best {
    margin-top: 22px;
    font-size: 22px;
    letter-spacing: 1px;
    color: var(--ink);
}

/* Intro: title rows slide down in one after another (".intro-in" is added one frame after the screen shows). */
.intro {
    opacity: 0;
    translate: 0 -24px;
    transition-property: opacity, translate, scale;
    transition-duration: 450ms, 450ms, 140ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out-back;
}

.intro-in .intro {
    opacity: 1;
    translate: 0 0;
}

.intro-in .intro--2 { transition-delay: 80ms, 80ms, 0ms; }
.intro-in .intro--3 { transition-delay: 160ms, 160ms, 0ms; }
.intro-in .intro--4 { transition-delay: 260ms, 260ms, 0ms; }
.intro-in .intro--5 { transition-delay: 360ms, 360ms, 0ms; }

/* ---------- Results screen ----------
   Celebrate first, details after (art direction 3.5): FINISH, the medal stamp, the time big, then a small delta chip,
   the lap report and the buttons. Order of the entrances (transition-delay): card 0 ms, FINISH 150 ms, time 250 ms,
   medal stamp 900 ms, delta 1000 ms, NEW RECORD 1050 ms, best + next 1100 ms, lap report 1150 ms, buttons 1300 ms. */
.card {
    width: 560px;
    align-items: center;
    padding: 24px 40px 30px 40px; /* bottom: 6 px of it is the plate's shadow */
    opacity: 0;
    translate: 0 40px;
    scale: 0.92 0.92;
    transition-property: opacity, translate, scale;
    transition-duration: 200ms, 320ms, 320ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
    transition-delay: 80ms;
}

.results--in .card {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.card--record {
    /* Room for the NEW RECORD stamp, which hangs over the top edge: without it the stamp covers FINISH. */
    padding-top: 46px;
}

/* Shake when the NEW RECORD stamp lands: 2 classes and after ".results--in .card", so these win.
   card--shaking is on for the whole shake and makes the way back quick (40 ms, no delay) instead of the slow entry. */
.results--in .card--shaking { transition-duration: 40ms; transition-delay: 0s; transition-timing-function: linear; }
.results--in .card--shake-l { translate: -5px 0; transition-duration: 0s; transition-delay: 0s; }
.results--in .card--shake-r { translate: 5px 0; transition-duration: 0s; transition-delay: 0s; }

/* FINISH lands like a stamp (scale down from big, a little overshoot). */
.res-headline {
    font-size: 64px;
    letter-spacing: 1px;
    color: var(--cc-white);
    -unity-text-outline-width: 4px;
    text-shadow: 0 6px 0 rgba(14, 34, 56, 0.75);
    opacity: 0;
    scale: 1.6 1.6;
    transition-property: opacity, scale;
    transition-duration: 160ms, 300ms;
    transition-timing-function: ease-out, ease-out-back;
    transition-delay: 150ms;
}

.results--in .res-headline {
    opacity: 1;
    scale: 1 1;
}

.final-time {
    margin-top: 2px;
    font-size: 92px;
    color: var(--cc-white);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 5px 0 rgba(14, 34, 56, 0.75);
    transition-property: scale;
    transition-duration: 220ms;
    transition-timing-function: ease-out-back;
}

.final-time--pop {
    scale: 1.12 1.12;
    transition-duration: 0s;
}

/* The difference to your best: a SMALL chip (never a banner). Coral = slower, mint = faster (new best). */
.res-delta {
    flex-direction: row;
    align-items: center;
    max-width: 100%;
    padding: 2px 16px 10px 14px;
    opacity: 0;
    translate: -30px 0;
    transition-property: opacity, translate;
    transition-duration: 240ms;
    transition-timing-function: ease-out-back;
    transition-delay: 1000ms; /* after the medal stamp (900 ms) */
}

.results--in .res-delta {
    opacity: 1;
    translate: 0 0;
}

.res-delta--ahead {
    background-image: url("Art/plate-mint.png");
}

.res-delta--first {
    background-image: none;
}

.res-delta-value {
    font-size: 26px;
    color: var(--cc-white);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    margin-right: 8px;
}

.res-delta-text {
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 19px;
    letter-spacing: 1px;
    color: var(--cc-white);
}

.res-delta--first .res-delta-text {
    color: var(--cc-sand);
    font-size: 21px;
}

.res-best {
    margin-top: 8px;
    font-size: 20px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.72);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-delay: 1100ms;
}

.results--in .res-best {
    opacity: 1;
}

/* Medal stamp: a pill badge in its own row under FINISH. It slams in (scale 1.8, turned -10 deg, to 1 at -3 deg). */
.res-medal {
    align-items: center;
    margin: 6px 0 4px 0;
}

.medal-badge {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 24px 0 20px;
    border-radius: 27px; /* half the height = a true pill */
    background-color: var(--ink);
    border-width: 4px;
    border-color: rgba(255, 246, 227, 0.30);
    opacity: 0;
    scale: 1.8 1.8;
    rotate: -10deg;
    transition-property: opacity, scale, rotate;
    transition-duration: 160ms, 260ms, 260ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
    transition-delay: 900ms;
}

.results--in .medal-badge {
    opacity: 1;
    scale: 1 1;
    rotate: -3deg;
}

/* No medal: no stamp, just a quiet fade (3 classes, so it beats the two rules above in both states). */
.res-medal .medal-badge.medal--none,
.results--in .medal-badge.medal--none {
    scale: 1 1;
    rotate: 0deg;
}

.medal-badge.medal--bronze { border-color: var(--medal-bronze); }
.medal-badge.medal--silver { border-color: var(--medal-silver); }
.medal-badge.medal--gold { border-color: var(--medal-gold); }
.medal-badge.medal--deans { border-color: var(--cc-white); background-color: var(--plate-blue-lo); }

.medal-gem--big {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    border-width: 3px;
}

.medal-badge-name {
    margin-left: 14px;
    font-size: 28px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.55);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.medal--bronze .medal-badge-name { color: var(--medal-bronze); }
.medal--silver .medal-badge-name { color: var(--medal-silver); }
.medal--gold .medal-badge-name { color: var(--medal-gold); }
.medal--deans .medal-badge-name { color: var(--cc-white); }

.res-medal-next {
    margin-top: 4px;
    font-size: 19px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.75);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-delay: 1150ms;
}

.results--in .res-medal-next {
    opacity: 1;
}

.res-medal-next--new {
    color: var(--sun);
}

/* Lap report: one strip, four equal cells, on a slightly lighter navy. */
.res-stats {
    flex-direction: row;
    width: 100%;
    margin-top: 14px;
    padding: 8px 0 9px 0;
    border-radius: 14px;
    background-color: rgba(24, 60, 96, 0.95);
    border-width: 2px;
    border-color: rgba(255, 246, 227, 0.16);
    opacity: 0;
    translate: 0 12px;
    transition-property: opacity, translate;
    transition-duration: 240ms;
    transition-timing-function: ease-out-back;
    transition-delay: 1150ms;
}

.results--in .res-stats {
    opacity: 1;
    translate: 0 0;
}

.stat {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    border-right-width: 2px;
    border-right-color: rgba(255, 246, 227, 0.12);
}

.stat--last {
    border-right-width: 0;
}

.stat-value {
    font-size: 30px;
    color: var(--cc-white);
}

.stat-caption {
    margin-top: 0;
    font-size: 16px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.65);
}

/* Nothing measured (0 drifts, 0 boosts, no top speed): "-" in a dim colour, never a "0" that looks broken. */
.stat--zero .stat-value {
    color: rgba(255, 246, 227, 0.35);
}

/* NEW RECORD: a mint stamp over the top edge of the card. */
.record {
    position: absolute;
    top: -34px;
    align-self: center;
    padding: 4px 24px 12px 24px;
    color: var(--cc-white);
    font-size: 34px;
    letter-spacing: 1px;
    opacity: 0;
    scale: 1.8 1.8;
    rotate: -10deg;
    transition-property: opacity, scale, rotate;
    transition-duration: 180ms, 260ms, 260ms;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
    transition-delay: 1050ms;
}

.results--in .record--on {
    opacity: 1;
    scale: 1 1;
    rotate: -3deg;
}

.res-actions {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-delay: 1300ms;
}

.results--in .res-actions {
    opacity: 1;
}

/* RETRY: the orange plate button. Pressed = it moves down onto its lip. */
.retry-button {
    margin: 0 10px 0 0;
    height: 62px;
    padding: 0 40px 6px 40px;
    font-size: 26px;
    letter-spacing: 1px;
    color: var(--cc-white);
    transition-property: scale, translate;
    transition-duration: 160ms, 80ms;
    transition-timing-function: ease-out-back, ease-out;
}

.retry-button:hover {
    scale: 1.05 1.05;
}

.retry-button:hover:active {
    scale: 0.97 0.97;
    translate: 0 3px;
}

/* =====================================================================================================
   Task P7: menu buttons, settings, credits, pause, sound toast, reduced motion.
   Same language as above: dark rounded tiles with a lip, true pills (radius = half the height), keycaps,
   azulejo diamonds. C# (UI/HudMenus.cs, SettingsPanel.cs, CreditsPanel.cs) only switches classes.
   ===================================================================================================== */

/* ---------- Menu buttons: a small navy plate with a keycap (start screen, results card, menu footers) ---------- */
.menu-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 22px;
}

.intro-in .intro--6 { transition-delay: 440ms, 440ms, 0ms; }

.menu-pill {
    flex-direction: row;
    align-items: center;
    height: 48px;
    margin: 0 5px;
    padding: 0 18px 6px 10px;
    transition-property: scale, translate;
    transition-duration: 160ms, 80ms;
    transition-timing-function: ease-out-back, ease-out;
}

.menu-pill:hover {
    scale: 1.06 1.06;
}

.menu-pill:hover:active {
    scale: 0.96 0.96;
    translate: 0 3px;
}

.menu-pill-text {
    margin-left: 8px;
    font-size: 19px;
    letter-spacing: 1px;
    color: var(--cc-white);
}

/* The sound pill while muted: the word turns orange, so "off" is seen at a glance. */
.menu-pill--muted .menu-pill-text {
    color: var(--cc-orange);
}

.menu-pill--results {
    height: 50px;
    margin: 0 0 0 14px;
    padding-right: 14px;
}

/* Close = the main action of a menu, so it is an orange plate like the start prompt and RETRY. */
.menu-pill--close {
    margin-top: 14px;
}

.menu-pill--close .menu-pill-text {
    color: var(--ink);
}

.keycap--small {
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    margin: 0;
    border-radius: 6px;
    border-bottom-width: 3px;
}

.keycap--small > Label {
    font-size: 15px;
}

/* ---------- Menu overlay + card (settings and credits) ---------- */
.menu-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

.menu-overlay.is-shown {
    opacity: 1;
}

.menu-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(18, 59, 94, 0.62); /* blue-deep: the start or results screen stays visible behind */
}

.menu-card {
    width: 640px;
    align-items: center;
    padding: 22px 34px 30px 34px;
    translate: 0 40px;
    scale: 0.92 0.92;
    transition-property: translate, scale;
    transition-duration: 320ms, 320ms;
    transition-timing-function: ease-out-back, ease-out-back;
}

.menu-overlay.is-shown .menu-card {
    translate: 0 0;
    scale: 1 1;
}

.menu-title {
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--cc-white);
}

.menu-keys {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
}

/* ---------- Settings rows ---------- */
.set-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 50px;
    margin-top: 4px;
    padding: 0 14px 0 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(24, 60, 96, 0.9);
    transition-property: background-color, border-color;
    transition-duration: 120ms;
}

.set-row:hover {
    background-color: rgba(30, 72, 114, 0.95);
}

/* The row the keys change (W/S): blue accent bar like the time panel. */
.set-row--selected,
.set-row--selected:hover {
    background-color: rgba(30, 107, 179, 0.95);
    border-color: var(--cc-white);
}

.set-name {
    width: 190px;
    font-size: 19px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.82);
}

.set-row--selected .set-name {
    color: var(--cc-white);
}

.set-control {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.set-step {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgba(255, 246, 227, 0.12);
    align-items: center;
    justify-content: center;
    transition-property: background-color, scale;
    transition-duration: 100ms, 140ms;
    transition-timing-function: linear, ease-out-back;
}

/* Minus = one bar, plus = the same bar twice, the second turned 90 degrees (no font glyph needed). */
.set-step-bar {
    position: absolute;
    width: 12px;
    height: 3px;
    border-radius: 1px;
    background-color: var(--cc-white);
}

.set-step-bar--v {
    rotate: 90deg;
}

.set-step:hover {
    background-color: rgba(255, 246, 227, 0.26);
}

.set-step:hover:active {
    scale: 0.88 0.88;
}

/* Volume bar: ten azulejo diamonds (cells made in SettingsPanel.cs), lit up to the volume. */
.set-bar {
    flex-direction: row;
    margin: 0 8px;
}

.set-cell {
    width: 22px;
    height: 30px;
    align-items: center;
    justify-content: center;
}

.set-cell-gem {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    rotate: 45deg;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 246, 227, 0.16);
    transition-property: background-color, scale;
    transition-duration: 100ms, 140ms;
    transition-timing-function: linear, ease-out-back;
}

.set-cell--on .set-cell-gem {
    background-color: var(--cc-white);
}

.set-row--selected .set-cell--on .set-cell-gem {
    background-color: var(--cc-orange);
}

.set-cell:hover .set-cell-gem {
    scale: 1.3 1.3;
}

/* Muted: the master bar keeps its level (unmute brings it back) but shows hollow diamonds. */
.set-row--muted .set-cell--on .set-cell-gem,
.set-row--selected.set-row--muted .set-cell--on .set-cell-gem {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 246, 227, 0.55);
}

.set-value {
    width: 76px;
    font-size: 22px;
    color: var(--cc-white);
    -unity-text-align: middle-right;
}

.set-row--muted .set-value {
    color: var(--cc-orange);
}

/* On/off switch: a pill track with a round knob that slides right when on. */
.set-switch {
    width: 54px;
    height: 28px;
    padding: 3px;
    border-radius: 14px;
    background-color: rgba(255, 246, 227, 0.16);
    transition-property: background-color;
    transition-duration: 120ms;
}

.set-knob {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--cc-white);
    transition-property: translate;
    transition-duration: 160ms;
    transition-timing-function: ease-out-back;
}

.set-row--on .set-switch {
    background-color: var(--cc-blue);
}

.set-row--on .set-knob {
    translate: 26px 0;
}

.set-row--toggle .set-value {
    color: rgba(255, 246, 227, 0.55);
}

.set-row--toggle.set-row--on .set-value {
    color: var(--cc-white);
}

.set-note {
    margin-left: 14px;
    font-size: 15px;
    letter-spacing: 1px;
    color: rgba(255, 246, 227, 0.60);
}

/* ---------- Credits: two pages in one fixed box, the shown one fades and slides in ---------- */
.credits-pages {
    width: 100%;
    height: 330px; /* page 2 lists tools, sound, characters, map data and fonts */
    margin-top: 2px;
}

.credits-page {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    opacity: 0;
    translate: 24px 0;
    transition-property: opacity, translate;
    transition-duration: 200ms, 260ms;
    transition-timing-function: ease-out, ease-out-cubic;
}

.credits-page.is-shown {
    opacity: 1;
    translate: 0 0;
}

.credits-head {
    margin-top: 6px;
    margin-bottom: 6px;
    font-size: 17px;
    letter-spacing: 3px;
    color: var(--cc-sand);
}

.credits-head--next {
    margin-top: 8px;
}

.credits-team {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
}

.credit-person {
    width: 50%;
    flex-direction: row;
    align-items: center;
    padding: 12px 8px 12px 8px;
}

/* Role number on an azulejo diamond, like the countdown tile. */
.credit-badge {
    width: 40px;
    height: 40px;
    margin: 0 18px 0 10px;
    border-radius: 8px;
    rotate: 45deg;
    align-items: center;
    justify-content: center;
    background-color: var(--cc-blue);
    border-width: 3px;
    border-color: var(--cc-white);
}

.credit-badge-num {
    rotate: -45deg;
    font-size: 20px;
    color: var(--cc-white);
    -unity-text-outline-width: 2px;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.credit-words {
    flex-shrink: 1;
}

.credit-name {
    font-size: 21px;
    letter-spacing: 1px;
    color: var(--cc-white);
}

.credit-role {
    margin-top: 2px;
    font-size: 15px;
    letter-spacing: 1px;
    white-space: normal;
    color: rgba(255, 246, 227, 0.70);
}

.credit-text {
    max-width: 100%;
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(255, 246, 227, 0.92);
}

.credits-foot {
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(255, 246, 227, 0.62);
}

.credits-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.credits-dot {
    width: 12px;
    height: 12px;
    margin: 0 8px;
    border-radius: 3px;
    rotate: 45deg;
    background-color: rgba(255, 246, 227, 0.25);
    transition-property: background-color;
    transition-duration: 120ms;
}

.credits-dot--on {
    background-color: var(--cc-sand);
}

.credits-footer .menu-pill--next {
    margin-left: 18px;
}

.credits-footer .menu-pill--close {
    margin-top: 0;
}

/* ---------- Pause (focus lost during the countdown or the race) ---------- */
.pause-screen.is-shown {
    opacity: 1;
}

.pause-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(18, 59, 94, 0.80);
}

.pause-content {
    align-items: center;
}

.pause-title {
    font-size: 84px;
    letter-spacing: 2px;
    color: var(--cc-white);
    -unity-text-outline-width: 4px;
    text-shadow: 0 6px 0 rgba(14, 34, 56, 0.75);
}

.pause-pill {
    margin-top: 22px;
}

.pause-note {
    margin-top: 18px;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--cc-sand);
}

/* ---------- Sound toast (key M) ---------- */
.toast {
    position: absolute;
    bottom: 96px;
    flex-direction: row;
    align-items: center;
    height: 50px;
    padding: 0 20px 6px 12px;
    opacity: 0;
    translate: 0 14px;
    transition-property: opacity, translate;
    transition-duration: 160ms, 220ms;
    transition-timing-function: ease-out, ease-out-back;
}

.toast.is-shown {
    opacity: 1;
    translate: 0 0;
}

.toast-text {
    margin-left: 10px;
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--cc-white);
}

.toast--off .toast-text {
    color: var(--cc-orange);
}

/* On the start and results screens the middle is full (title, results card): the toast goes to the bottom-left corner. */
.st-ready .toast,
.st-results .toast {
    left: 34px;
    bottom: 26px;
}

/* ---------- Reduced motion (settings) ----------
   RaceHud puts "reduce-motion" on .hud-root. Everything still fades (opacity), but nothing slides, shakes,
   punches or spins. Each rule has one class more than the rule it beats; they are last in the file, so they
   also win every tie. Not covered here (C# checks the setting): the breathing start pill (an inline style). */
.reduce-motion .intro,
.reduce-motion .callout-chip,
.reduce-motion .split-chip,
.reduce-motion .card,
.reduce-motion .res-delta,
.reduce-motion .res-stats,
.reduce-motion .toast,
.reduce-motion .menu-card,
.reduce-motion .credits-page {
    translate: 0 0;
}

.reduce-motion .panel--pop,
.reduce-motion .medal-target--pop,
.reduce-motion .cp-pip--pop,
.reduce-motion .split-chip--pop,
.reduce-motion .speed--pop,
.reduce-motion .drift-label--pop,
.reduce-motion .drift-pip--pop,
.reduce-motion .drift-bar--pop,
.reduce-motion .final-time--pop,
.reduce-motion .pill--pop,
.reduce-motion .wrong-way-chip--pulse,
.reduce-motion .menu-card {
    scale: 1 1;
}

.reduce-motion .callout.is-shown .callout-chip--shake-l,
.reduce-motion .callout.is-shown .callout-chip--shake-r,
.reduce-motion .results--in .card--shake-l,
.reduce-motion .results--in .card--shake-r {
    translate: 0 0;
}

.reduce-motion .callout.is-shown .callout-chip--pop {
    scale: 1 1;
}

/* Countdown: the number fades in instead of punching, GO fades out instead of flying up, no white flash. */
.reduce-motion .cd-tile--pop {
    scale: 1 1;
    rotate: 45deg;
}

.reduce-motion .cd--go .cd-tile--pop-go {
    scale: 1 1;
}

.reduce-motion .cd--exit,
.reduce-motion .cd.is-shown.cd--exit {
    translate: 0 0;
    scale: 1 1;
}

.reduce-motion .go-flash--pop {
    opacity: 0;
}

/* Results stamps fade in at their final angle instead of slamming down. */
.reduce-motion .record {
    scale: 1 1;
    rotate: -3deg;
}

.reduce-motion .res-headline,
.reduce-motion .card {
    scale: 1 1;
}

.reduce-motion .medal-badge {
    scale: 1 1;
    rotate: -3deg;
}

/* No light streak running through the drift bar while boosting (the bar itself still turns orange). */
.reduce-motion .drift-shine {
    opacity: 0;
}

/* ---------- Finish moment (task P6b) ----------
   RaceHud puts "st-finish" on .hud-root for the whole Results state. For the first 0.6 s (the "finish beat", the
   game is in slow motion) the results card is not there yet: the lap time panel grows a little and turns sand,
   the exact time in full white, while the parts that no longer matter step back. Then st-results fades the card in
   over all of it. These rules are last in the file and have one class more than the rules they beat. */
.st-finish .time-panel {
    scale: 1.12 1.12;
    transition-property: scale;
    transition-duration: 320ms;
    transition-timing-function: ease-out-back;
}

.st-finish .timer-fraction {
    color: var(--cc-white);
}

/* The drift meter and the speed gauge stay in place (no layout jump) and only fade. */
.st-finish .drift-panel,
.st-finish .speed-gauge {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

/* The next-medal chip can already show the next target after a new medal: hide it, the card tells the story. */
.st-finish .medal-target.is-shown,
.st-finish .ghost-chip.is-shown {
    opacity: 0;
}

/* Reduced motion: no beat (the card comes at once) and no growing panel. */
.reduce-motion.st-finish .time-panel {
    scale: 1 1;
}
